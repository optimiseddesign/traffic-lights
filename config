[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/optimiseddesign/traffic-lights
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[credential]
	helper = 
	helper = C:/Program\\ Files/SmartGit/bin/smartgitc.exe --credential
	useHttpPath = true
[taggrouping]
	groups = 
	singles = 
[pull]
	rebase = false
[smartgit "fetch"]
	tags = true
[submodule "robot/libraries/codal-microbit-v2"]
	url = https://github.com/lancaster-university/codal-microbit-v2
	active = true
[submodule "robot/libraries/codal-core"]
	url = https://github.com/lancaster-university/codal-core
	active = true
[submodule "robot/libraries/codal-nrf52"]
	url = https://github.com/lancaster-university/codal-nrf52
	active = true
[submodule "robot/libraries/codal-microbit-nrf5sdk"]
	url = https://github.com/microbit-foundation/codal-microbit-nrf5sdk
	active = true
